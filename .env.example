# Local MT5 optimizer — only your TradeEcho User ID is required.
# Copy to `.env` in this folder. Never commit real values.
# Scripts: `python mt5_heartbeat.py`, … — see README.md.

# Your User ID from TradeEcho dashboard → Setup (Ultimate plan required)
TRADEECHO_USER_ID=

# Optional — defaults to ./SetFiles if it has .set files, else ../../EAs/SetFiles
# MT5_SET_DIR=../../EAs/SetFiles

# Compiled EA in MQL5\Experts (required for optimize + dashboard Start/Resume)
MT5_EXPERT=

# Optional — path to terminal64.exe (else first existing FTMO / MetaTrader 5 install)
# MT5_TERMINAL=C:\Program Files\MetaTrader FTMO\terminal64.exe

# Optional — EA input names / skip grids (defaults match TrendReversal family)
# MT5_RISK_INPUT=RISK
# MT5_SKIP_DAY_INPUT=SKIP_TRADE_DAY
# MT5_SKIP_MONTH_INPUT=SKIP_MONTH
# MT5_SKIP_DAY_GRID=0||1||1||5||Y
# MT5_SKIP_MONTH_GRID=0||1||1||12||Y

# Optional — TradeEcho API host (defaults to https://ea-sync-production.up.railway.app)
# TRADEECHO_API_BASE_URL=https://ea-sync-production.up.railway.app

# Local dev only — skip Ultimate subscription API check
# TRADEECHO_SKIP_ACCESS_CHECK=1
